<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for "PayHub Merchant".

  Regenerated by `xcodegen generate` from `project.yml` — the values here
  mirror `targets.PayHubMerchant.entitlements.properties`. We commit the
  file so a fresh checkout has the correct Associated Domains list even
  before someone runs xcodegen, and so code review can spot changes.

  Adding a new entitlement (e.g. push environment, app groups) → edit
  `project.yml`, then `xcodegen generate` to refresh this plist.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:app.payhub.ly</string>
    </array>
</dict>
</plist>
